    "migrate:escalioncloud-urls:apply": "node scripts/migrateEscalionCloudUrls.js --apply",
    "migrate:multiple-prequels": "node scripts/migrateMultiplePrequels.js",
    "migrate:multiple-prequels:apply": "node scripts/migrateMultiplePrequels.js --apply"
